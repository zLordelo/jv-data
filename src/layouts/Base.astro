---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { company, seo } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** Dados estruturados (schema.org) extras para esta página. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, jsonLd, noindex = false } = Astro.props;

const site = Astro.site ?? new URL('http://localhost');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(withBase(seo.ogImage), site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={company.name} />
    <meta name="theme-color" content="#0A1830" />
    <meta name="format-detection" content="telephone=no" />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" preload />

    <link rel="icon" href={withBase('assets/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('assets/favicon-192.png')} />
    <link rel="apple-touch-icon" href={withBase('assets/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Marca que o JS está ativo antes da pintura: as animações só escondem conteúdo quando há JS. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
