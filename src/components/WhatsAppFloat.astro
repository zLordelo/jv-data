---
import Icon from './Icon.astro';

interface Props {
  waLink: string;
}

const { waLink } = Astro.props;
---

<a
  class="wa-float"
  href={waLink}
  target="_blank"
  rel="noopener"
  aria-label="Conversar no WhatsApp"
  data-cta="flutuante"
  data-wa-float
>
  <Icon name="whatsapp" size={28} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 60;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  /* Com JS, o botão só aparece depois que o visitante passa da primeira dobra. */
  :global(.js) .wa-float:not(.is-visible) {
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    visibility: hidden;
  }

  .wa-float:hover {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wa-float::before {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 2px solid #25d366;
      animation: ping 2.4s ease-out infinite;
    }
  }

  @keyframes ping {
    0% {
      transform: scale(0.9);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
</style>
