---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { company, faq, seo, services, waMessages } from '../data/site';
import { buildWhatsAppLink } from '../lib/whatsapp';
import { withBase } from '../lib/paths';
import logo from '../assets/brand/jv-data-logo.png';

const waLink = buildWhatsAppLink(company.whatsapp, waMessages.default);

const site = Astro.site ?? new URL('http://localhost');
const home = new URL(withBase('/'), site).href;
const orgId = `${home}#organizacao`;

// Dados estruturados (schema.org): ajudam o Google a entender quem é a empresa,
// o que ela oferece e as perguntas frequentes. Gerados a partir do mesmo conteúdo da página.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': orgId,
      name: company.name,
      slogan: company.tagline,
      description: company.description,
      url: home,
      logo: new URL(logo.src, site).href,
      image: new URL(withBase(seo.ogImage), site).href,
      telephone: `+${company.whatsapp}`,
      areaServed: { '@type': 'Country', name: 'Brasil' },
      knowsAbout: ['Power BI', 'Business Intelligence', 'Power Automate', 'Python', 'Excel', 'SQL', 'Automação de processos'],
      founder: company.founders.map((f) => ({ '@type': 'Person', name: f.name, jobTitle: f.role })),
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: `+${company.whatsapp}`,
        url: waLink,
        availableLanguage: 'Portuguese',
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Serviços',
        itemListElement: services.items.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: `${s.title} (${s.tools})`, description: s.text },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#site`,
      url: home,
      name: company.name,
      inLanguage: 'pt-BR',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'FAQPage',
      '@id': `${home}#duvidas`,
      mainEntity: faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<Base jsonLd={jsonLd}>
  <Header waLink={waLink} />
  <main id="conteudo" tabindex="-1">
    <Hero waLink={waLink} />
    <Problems />
    <Services />
    <Projects />
    <Process />
    <About />
    <Faq />
    <FinalCta waLink={waLink} />
  </main>
  <Footer waLink={waLink} />
  <WhatsAppFloat waLink={waLink} />
</Base>

<script>
  import { initPage } from '../scripts/page';
  initPage();
</script>
