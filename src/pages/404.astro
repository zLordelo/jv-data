---
import Base from '../layouts/Base.astro';
import { company, waMessages } from '../data/site';
import { buildWhatsAppLink } from '../lib/whatsapp';
import { withBase } from '../lib/paths';
---

<Base title="Página não encontrada | JV Data" description="Esta página não existe. Volte para o início do site da JV Data." noindex>
  <main id="conteudo" class="wrap notfound">
    <p class="eyebrow">Erro 404</p>
    <h1>Não encontramos esta página</h1>
    <p>O link pode estar errado ou a página mudou de lugar.</p>
    <div class="ctas">
      <a class="btn btn-primary" href={withBase('/')}>Voltar para o início</a>
      <a class="btn link" href={buildWhatsAppLink(company.whatsapp, waMessages.default)} target="_blank" rel="noopener">Falar no WhatsApp</a>
    </div>
  </main>
</Base>

<style>
  .notfound {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
  .link {
    color: var(--teal-deep);
    border-color: var(--teal-deep);
  }
</style>
